[mqtt]
host = mosquitto

[device]
; serial_device defaults to /dev/ttyAUTOTERM in the image's config.default.ini:
; a udev symlink to the USB-serial adapter wired to the heater (see
; driver-autoterm's README, "Installing"). Compose passes that symlink through.
; serial_device = /dev/ttyAUTOTERM
;
; NOTE: once the broker is cut over (BROKER_ACL_OPEN=0, ADR 0026) it refuses anonymous
; clients and the broker ACL decides who may command this entity. Until then the broker
; still accepts anonymous clients, so with this true anyone who can reach port 1883
; can start and stop the heater. Keep it false unless the broker is cut over or only
; reachable from the van's own network.
commands_enabled = false
