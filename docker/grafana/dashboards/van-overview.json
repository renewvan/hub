{
  "uid": "van-overview",
  "title": "Van overview",
  "tags": ["renewvan"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "battery",
        "label": "Battery",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "renewvan-influxdb"
        },
        "query": "import \"influxdata/influxdb/schema\"\n\nschema.tagValues(bucket: \"renewvan\", tag: \"id\", predicate: (r) => r._measurement == \"battery\", start: -30d)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "description": "Battery source used for the derived loads. Pick the one that shares a bank with the solar controller."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Tanks now",
      "description": "Last known level per tank (fresh, grey).",
      "type": "gauge",
      "datasource": {
        "type": "influxdb",
        "uid": "renewvan-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "renewvan-influxdb"
          },
          "query": "from(bucket: \"renewvan\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"tank\" and r._field == \"level_pct\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "${__field.labels.id}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
