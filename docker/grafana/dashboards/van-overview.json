    {
      "id": 9,
      "title": "Power balance",
      "description": "Loads = solar + charger - battery net power. Derived, not measured: it includes inverter and conversion losses, and misses any source the logger does not store.",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "renewvan-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "renewvan-influxdb"
          },
          "query": "from(bucket: \"renewvan\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"power_w\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"_time\"])\n  |> sum()\n  |> group()\n\n  |> set(key: \"id\", value: \"Solar in\")\n  |> group(columns: [\"id\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "renewvan-influxdb"
          },
          "query": "from(bucket: \"renewvan\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"battery\" and r._field == \"power_w\" and r.id == \"$battery\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"_time\"])\n  |> sum()\n  |> group()\n\n  |> set(key: \"id\", value: \"Battery (+ charging)\")\n  |> group(columns: [\"id\"])"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "renewvan-influxdb"
          },
          "query": "from(bucket: \"renewvan\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._field == \"power_w\" and (r._measurement == \"solar\" or r._measurement == \"charger\" or (r._measurement == \"battery\" and r.id == \"$battery\")))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _value: if r._measurement == \"battery\" then -r._value else r._value}))\n  |> group(columns: [\"_time\"])\n  |> sum()\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> map(fn: (r) => ({_time: r._time, _value: if r._value < 0.0 then 0.0 else r._value}))\n  |> set(key: \"id\", value: \"Loads (derived)\")\n  |> group(columns: [\"id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "displayName": "${__field.labels.id}",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
