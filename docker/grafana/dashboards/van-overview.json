          "query": "from(bucket: \"renewvan\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._field == \"power_w\" and (r._measurement == \"solar\" or r._measurement == \"charger\" or (r._measurement == \"battery\" and r.id == \"$battery\")))\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _value: if r._measurement == \"battery\" then -r._value else r._value}))\n  |> group(columns: [\"_time\"])\n  |> sum()\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> map(fn: (r) => ({_time: r._time, _value: if r._value < 0.0 then 0.0 else r._value}))\n  |> last()"
        }
