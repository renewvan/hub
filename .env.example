# Copy to `.env` next to docker-compose-truenas.yml and fill in the
# values marked "required" below. No secrets are committed here.
#
# TrueNAS Custom App users: set these in the Custom App's "Environment
# Variables" section instead of a `.env` file — see
# docker-compose-truenas.yml's header.

# --- Storage -----------------------------------------------------------
# Host path (dataset) every service's persistent data bind-mounts under.
APPDATA_PATH=/mnt/fast/apps/renewvan

# --- Image tags ----------------------------------------------------------
# Bumping a service to a new release is a single-line edit here — no
# submodule/cross-repo git operation. See
# docs/adr/0001-compose-services-via-pinned-images-not-git-submodules.md.
TANK_IMAGE_TAG=0.1.0
BATTERY_IMAGE_TAG=0.1.0
LOGGER_IMAGE_TAG=0.1.0
DASHBOARD_IMAGE_TAG=0.1.0

# --- InfluxDB --------------------------------------------------------
INFLUXDB_ADMIN_PASSWORD=renewvan-dev-only
INFLUXDB_ADMIN_TOKEN=renewvan-dev-token

# --- Van bus (this compose's Mosquitto) -------------------------------
# v0 Mosquitto (docker/mosquitto/config/mosquitto.conf) runs
# `allow_anonymous true` — no credentials required. Leave the
# VAN_BUS_USERNAME/PASSWORD pair blank until the broker is locked down;
# they're wired through to every service now so enabling auth later is
# a config-only change, no compose edit.
VAN_BUS_HOST=mosquitto
VAN_BUS_PORT=1883
VAN_BUS_USERNAME=
VAN_BUS_PASSWORD=

# --- tank ----------------------------------------------------------------
# ${APPDATA_PATH}/tank/config.ini must exist before first start (layered
# config.default.ini/config.ini override — see
# docs/porting-dbus-driver-to-mqtt.md). Host must expose /dev/i2c-1 (the
# ADS1115's bus) for the tank container's device passthrough to work.

# --- battery (required: Venus OS GX device reachability) -----------------
# The battery driver's SECOND MQTT connection: the Victron GX device's
# own broker, separate from this compose's van-bus Mosquitto above.
VICTRON_MQTT_HOST=
VICTRON_MQTT_PORT=1883
VICTRON_PORTAL_ID=

# --- dashboard (required: reachable WS URL) -------------------------------
# Mosquitto's WS listener as reachable from a browser/phone on the van's
# network — not the in-compose service name, since this is a client-side
# (browser) connection, not container-to-container.
VAN_BUS_WS_URL=ws://<truenas-ip>:9001
# Read-scoped credentials, only needed once VAN_BUS_USERNAME/PASSWORD
# above are set (broker auth enabled).
DASHBOARD_MQTT_USERNAME=
DASHBOARD_MQTT_PASSWORD=
