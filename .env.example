# Copy to `.env` next to docker-compose.yml and fill in the values marked "required" below. No secrets are committed here.

# --- InfluxDB --------------------------------------------------------
# SECRETS: leave these empty. bin/deploy.sh (bin/ensure-secrets.sh) generates them into the Pi's .env
# (mode 600) and refuses to deploy while one is empty or a legacy default. The admin pair is
# operator-only; the logger, Grafana and the dashboard's /influx proxy each get their own bucket-scoped token.
# For a plain `docker compose` run on a dev machine, generate them yourself (`openssl rand -hex 32`).
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=
INFLUXDB_LOGGER_TOKEN=
INFLUXDB_GRAFANA_TOKEN=
INFLUXDB_DASHBOARD_TOKEN=
# Grafana's admin password (the username is admin). Same rule: generated, never an example value.
GF_SECURITY_ADMIN_PASSWORD=
# History bucket retention: an InfluxDB duration ("8760h" = 1 year, "2160h" =
# 90 days) or 0 = keep forever (the default). Only read when setup creates the
# bucket on a fresh install; an existing bucket ignores it until updated once
# (see the comment at DOCKER_INFLUXDB_INIT_BUCKET_RETENTION in docker-compose.yml).
INFLUXDB_RETENTION=0

# --- Renewvan hub (this compose's Mosquitto) ---------------------------
# The repo default Mosquitto (docker/mosquitto/config/mosquitto.conf) runs
# `allow_anonymous true`. A deployment that requires a password on 1883 needs
# MORE than this pair, because not every Driver reads it:
#   - logger, driver-venus, driver-router and driver-demo read MQTT_USERNAME/PASSWORD
#     from the environment, which compose fills from this pair.
#   - driver-tank, driver-gps, driver-temperature, driver-tilt and driver-wattcycle IGNORE the environment
#     and read `username`/`password` from the `[mqtt]` section of their own
#     config.ini (/etc/renewvan/<driver>/config.ini). Locking the broker with only
#     this pair set takes those five offline (`MQTT connect failed with rc=5`).
#   - the host plugins read MQTT_USERNAME/PASSWORD from
#     /etc/renewvan/kiosk.env and /etc/renewvan/tailscale.env, and the ESP32
#     relay from its secrets.yaml.
# Give EVERY client its credential first, then require auth, and keep the old
# mosquitto.conf to roll back to. See docs/adr/0025-broker-has-per-client-accounts-and-anonymous-read-only.md.
#
# Per-client accounts (ADR 0025), all generated by bin/ensure-secrets.sh, never by hand:
#   MQTT_<CLIENT>_PASSWORD   one per client (TANK, GPS, TEMPERATURE, TILT, WATTCYCLE, AUTOTERM, VEDIRECT,
#                            LOGGER, VENUS, ROUTER, DEMO, KIOSK, TAILSCALE, HUB, COMMAND, READER, plus one esp32-<name> per board); the
#                            username is the client key. COMMAND is the dashboard's, public via /env.js.
#                            READER is the read-only login for MQTT Explorer and dev tools (no writes).
#   LOGIN_USER/LOGIN_PASSWORD_HASH/LOGIN_SESSION_SECRET   the dashboard login (scrypt hash only; the password is shown once).
#   BROKER_ACL_OPEN          1 = migration: the temporary `topic readwrite renewvan/#` line (anonymous only) is in the ACL and
#                            allow_anonymous is true. 0 = cut over: no such line and allow_anonymous false, so
#                            every client needs an account. Set by bin/cutover-broker-acl.sh; bin/ensure-secrets.sh
#                            never reopens it.
# Rotate one with bin/rotate-secret.sh <client>.
MQTT_TANK_PASSWORD=
MQTT_GPS_PASSWORD=
MQTT_TEMPERATURE_PASSWORD=
MQTT_TILT_PASSWORD=
MQTT_WATTCYCLE_PASSWORD=
MQTT_AUTOTERM_PASSWORD=
MQTT_VEDIRECT_PASSWORD=
MQTT_LOGGER_PASSWORD=
MQTT_VENUS_PASSWORD=
MQTT_ROUTER_PASSWORD=
MQTT_DEMO_PASSWORD=
MQTT_KIOSK_PASSWORD=
MQTT_TAILSCALE_PASSWORD=
MQTT_HUB_PASSWORD=
MQTT_COMMAND_PASSWORD=
MQTT_READER_PASSWORD=
LOGIN_USER=
LOGIN_PASSWORD_HASH=
LOGIN_SESSION_SECRET=
BROKER_ACL_OPEN=
# Space-separated ESP32 board names (ADR 0027, hub#162): each gets an account esp32-<name> with its own password,
# MQTT_ESP32_<NAME>_PASSWORD (generated), allowed to write only renewvan/esp32-<name>/#. Use the name the board is flashed with.
BROKER_ESP32_BOARDS=
RENEWVAN_HOST=mosquitto
RENEWVAN_PORT=1883

# Host path to the Mosquitto config directory. Default assumes the repo's
# own docker/mosquitto/config/ next to this file; a `bin/deploy.sh`
# deployment (see README) overrides this to /etc/renewvan/mosquitto/ so
# host-specific broker config (topic ACLs, auth) doesn't live inside the
# deployed app directory.
MOSQUITTO_CONFIG_PATH=./docker/mosquitto/config

# --- tank ------------------------------------------------------------
# Host path to the layered config.default.ini/config.ini override — see
# docs/authoring-a-driver.md. Must exist before first start.
# Host must expose /dev/i2c-1 (the ADS1115's bus) for the tank
# container's device passthrough to work. A `bin/deploy.sh` deployment
# (see README) overrides this to /etc/renewvan/tank/config.ini, same
# reasoning as MOSQUITTO_CONFIG_PATH above.
TANK_CONFIG_PATH=./config/tank/config.ini

# --- gps ---------------------------------------------------------------
# Host path to the layered config.default.ini/config.ini override. The
# image's own defaults (serial_port=/dev/ttyACM0, baud_rate=9600) match a
# u-blox-native USB GNSS receiver out of the box; this file only needs
# to set [mqtt] host = mosquitto (container-to-container) -- no
# calibration/secret like tank, so a `bin/deploy.sh` deployment
# auto-seeds this from docker/gps/config.ini.default instead of
# requiring a manual placement step. The gps service is behind the `gps`
# compose profile and the host must expose the module at /dev/ttyACM0
# (hardcoded in docker-compose.yml's `devices:` and in bin/deploy.sh's
# presence check; a CP2102/CH340 module on /dev/ttyUSB0 needs both changed).
# `bin/deploy.sh` enables the profile only when that device exists.
GPS_CONFIG_PATH=./config/gps/config.ini

# --- temperature -------------------------------------------------------
# Host path to the config.ini override (sets [mqtt] host = mosquitto and
# the [sensor.<id>] probe-to-id/name/unit mapping). `bin/deploy.sh`
# auto-seeds it from docker/temperature/config.ini.default. Unmapped probes
# are still published under their serial, so the driver works with no edits.
TEMPERATURE_CONFIG_PATH=./config/temperature/config.ini
# Writable host dir for dashboard edits (name/unit); must persist across
# container recreates or edits are lost.
TEMPERATURE_STATE_PATH=./config/temperature/state

# --- tilt --------------------------------------------------------------
# Host path to the config.ini override (sets [mqtt] host = mosquitto, the
# state_dir, and the axis mapping for how the GY-521 is mounted).
# `bin/deploy.sh` auto-seeds it from docker/tilt/config.ini.default; check
# the axis_* lines against your mounting (see driver-tilt's README).
TILT_CONFIG_PATH=./config/tilt/config.ini
# Writable host dir holding the install level zero; must persist across
# container recreates or the zero is lost.
TILT_STATE_PATH=./config/tilt/state

# --- venus (only if the van runs Venus OS) ---------------------------------
# driver-venus's SECOND MQTT connection: the Venus OS device's own broker
# (Cerbo GX, or a Pi running Venus OS), separate from this compose's
# renewvan-bus Mosquitto above. It publishes the battery, solar and charger
# entities. driver-venus is behind the `venus` compose profile: leave
# VENUS_MQTT_HOST empty and bin/deploy.sh does not start it; set it (and
# VENUS_PORTAL_ID) and deploy.sh enables the profile.
VENUS_MQTT_HOST=
VENUS_MQTT_PORT=1883
VENUS_PORTAL_ID=

# --- wattcycle (BLE battery) ------------------------------------------
# Host path to the config.ini override (sets [mqtt] host = mosquitto and the
# [driver] mac of this van's battery). `bin/deploy.sh` auto-seeds it from
# docker/wattcycle/config.ini.default. driver-wattcycle stays off until the
# mac is set. The battery must be in BLE range of the hub's Bluetooth adapter.
WATTCYCLE_CONFIG_PATH=./config/wattcycle/config.ini

# --- autoterm ----------------------------------------------------------
# driver-autoterm's config.ini (Autoterm AIR 2D heater over USB-serial,
# /dev/ttyAUTOTERM). `bin/deploy.sh` auto-seeds it from
# docker/autoterm/config.ini.default and enables the driver only when the
# device exists. Commands stay off until commands_enabled = true in it.
AUTOTERM_CONFIG_PATH=./config/autoterm/config.ini

# --- vedirect ----------------------------------------------------------
# driver-vedirect's config.ini (Victron VE.Direct USB cables). `bin/deploy.sh`
# auto-seeds it from docker/vedirect/config.ini.default and enables the driver
# only when a /dev/serial/by-id entry matches its [serial] port_globs.
VEDIRECT_CONFIG_PATH=./config/vedirect/config.ini

# --- router ------------------------------------------------------------
# <id> segment of renewvan/router/<id>/… — single router per hub.
ROUTER_ID=main

# --- dashboard ------------------------------------------------------------
# How the browser (kiosk, phone, laptop) reaches the broker's WebSocket.
# `/mqtt` means "this page's own host": the dashboard's nginx proxies it to
# mosquitto:9001, so a client needs only the port it loaded the page from
# (80). It works on the van LAN, over Tailscale/WireGuard, and survives a
# router/IP change. Needs dashboard >= v0.7.1.
# A full URL (ws://<host>:9001) also works, but then every client must reach
# that host AND port 9001, and the host goes stale when the Pi's IP changes.
VITE_MQTT_WS_URL=/mqtt
# The dashboard's broker account is `command` (MQTT_COMMAND_PASSWORD above): compose passes it to the
# dashboard as VITE_MQTT_USERNAME/PASSWORD. It is public through /env.js; the dashboard login is the gate.

# Host path of the Basemap: the one .pmtiles file the Map page draws offline,
# mounted read-only (single file, not a directory) at /maps/basemap.pmtiles.
# `bin/deploy.sh` creates the directory and an EMPTY placeholder if no file is
# there (so the Map page shows "no map" instead of Docker creating a directory),
# and never overwrites an existing file. Put a real one there with
# `scripts/push-basemap.sh <file>`; see the dashboard's offline-map guide for
# how to build it.
DASHBOARD_BASEMAP_PATH=./config/dashboard/basemap.pmtiles

# Pi only. The broker (1883, 9001) listens on loopback; the Pi also publishes it on its
# van-LAN IPv4 address through docker-compose.lan.yml, so an uplink interface (cellular/
# Starlink) cannot reach it. Local dev leaves both of these unset: loopback only, no setup.
# bin/deploy.sh sets COMPOSE_FILE, seeds MQTT_BIND_ADDR from DASHBOARD_HOST when that is an
# IPv4 address, and refuses to deploy if it is not an address of the Pi.
# Check it: docs/reference.md "Broker reachability".
# COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml
MQTT_BIND_ADDR=
# Pi only: the Pi's Tailscale IPv4 address (`tailscale ip -4`). Caddy's 443 is published on it and on
# MQTT_BIND_ADDR, never on every interface. bin/deploy.sh seeds it and refuses to deploy without it.
TAILSCALE_BIND_ADDR=
# Pi only: the Pi's MagicDNS name (`tailscale status --json`, Self.DNSName, without the trailing dot), e.g.
# renewvan.<tailnet>.ts.net. The Caddyfile serves the site under it, and its certificate names it, so browse
# by this name over Tailscale. bin/deploy.sh seeds it; empty is fine when MagicDNS is off.
TAILSCALE_DNS_NAME=

# LAN IP or local name the kiosk is reached at over https (Caddy `tls internal`, see the caddy service in docker-compose.yml).
DASHBOARD_HOST=

# --- kiosk plugin (display power bridge, systemd service on Pi host) ------
# The kiosk plugin runs outside Docker; its env is sourced from
# /etc/renewvan/kiosk.env on the Pi (seeded by bin/deploy.sh).
# Defaults connect to localhost:1883 with no auth — matches the compose
# Mosquitto when run on the same Pi. Override if broker is elsewhere or
# auth is enabled.
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Display power defaults to the backlight's bl_power sysfs device (works under
# cage, which has no output-power protocol). Set ALL THREE to override with an
# external command instead, e.g. for a panel with no backlight device:
# DISPLAY_ON_CMD=vcgencmd display_power 1
# DISPLAY_OFF_CMD=vcgencmd display_power 0
# DISPLAY_QUERY_CMD=vcgencmd display_power
# Touch device for touch-to-wake (auto-detected if unset).
# Set explicitly if auto-detection picks the wrong device.
# TOUCH_DEVICE=/dev/input/event4
