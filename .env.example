# Copy to `.env` next to docker-compose.yml and fill in the values
# marked "required" below. No secrets are committed here.

# --- Image tags ----------------------------------------------------------
# Bumping a service to a new release is a single-line edit here — no
# submodule/cross-repo git operation. See
# docs/adr/0001-compose-services-via-pinned-images-not-git-submodules.md.
NODE_TANK_IMAGE_TAG=v0.1.3
NODE_BATTERY_IMAGE_TAG=v0.1.3
LOGGER_IMAGE_TAG=v0.1.1
DASHBOARD_IMAGE_TAG=v0.1.2

# --- InfluxDB --------------------------------------------------------
INFLUXDB_ADMIN_PASSWORD=renewvan-dev-only
INFLUXDB_ADMIN_TOKEN=renewvan-dev-token

# --- Renewvan bus (this compose's Mosquitto) ---------------------------
# v0 Mosquitto (docker/mosquitto/config/mosquitto.conf) runs
# `allow_anonymous true` — no credentials required. Leave the
# RENEWVAN_USERNAME/PASSWORD pair blank until the broker is locked down;
# they're wired through to every service now so enabling auth later is
# a config-only change, no compose edit.
RENEWVAN_HOST=mosquitto
RENEWVAN_PORT=1883
RENEWVAN_USERNAME=
RENEWVAN_PASSWORD=

# Host path to the Mosquitto config directory. Default assumes the repo's
# own docker/mosquitto/config/ next to this file; a `bin/deploy.sh`
# deployment (see README) overrides this to /etc/renewvan/mosquitto/ so
# host-specific broker config (topic ACLs, auth) doesn't live inside the
# deployed app directory.
MOSQUITTO_CONFIG_PATH=./docker/mosquitto/config

# --- tank ------------------------------------------------------------
# Host path to the layered config.default.ini/config.ini override — see
# docs/porting-dbus-to-mqtt-node.md. Must exist before first start.
# Host must expose /dev/i2c-1 (the ADS1115's bus) for the tank
# container's device passthrough to work. A `bin/deploy.sh` deployment
# (see README) overrides this to /etc/renewvan/tank/config.ini, same
# reasoning as MOSQUITTO_CONFIG_PATH above.
TANK_CONFIG_PATH=./config/tank/config.ini

# --- battery (required: Venus OS GX device reachability) -----------------
# The battery node's SECOND MQTT connection: the Victron GX device's
# own broker, separate from this compose's renewvan-bus Mosquitto above.
VICTRON_MQTT_HOST=
VICTRON_MQTT_PORT=1883
VICTRON_PORTAL_ID=

# --- dashboard (required: reachable WS URL) -------------------------------
# Mosquitto's WS listener as reachable from a browser/phone on the van's
# network — not the in-compose service name, since this is a client-side
# (browser) connection, not container-to-container.
VITE_MQTT_WS_URL=ws://<host>:9001
# Read-scoped credentials, only needed once RENEWVAN_USERNAME/PASSWORD
# above are set (broker auth enabled).
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# --- node-kiosk (display power bridge, systemd service on Pi host) --------
# node-kiosk runs outside Docker; its env is sourced from
# /etc/renewvan/node-kiosk.env on the Pi (seeded by bin/deploy.sh).
# Defaults connect to localhost:1883 with no auth — matches the compose
# Mosquitto when run on the same Pi. Override if broker is elsewhere or
# auth is enabled.
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Wayland fallback: replace vcgencmd with wlopm if needed.
# DISPLAY_ON_CMD=vcgencmd display_power 1
# DISPLAY_OFF_CMD=vcgencmd display_power 0
# DISPLAY_QUERY_CMD=vcgencmd display_power
