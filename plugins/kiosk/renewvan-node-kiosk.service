[Unit]
Description=renewvan kiosk display power bridge
Documentation=https://github.com/renewvan/hub/blob/main/plugins/kiosk/README.md
After=network.target mosquitto.service

[Service]
SupplementaryGroups=input
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
User=alexsanzder
EnvironmentFile=-/etc/renewvan/node-kiosk.env
ExecStart=/opt/renewvan/plugins/kiosk/.venv/bin/python /opt/renewvan/plugins/kiosk/node_kiosk.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
