[Unit]
Description=renewvan kiosk display power bridge
Documentation=https://github.com/renewvan/hub/blob/main/plugins/kiosk/README.md
After=network.target mosquitto.service

[Service]
SupplementaryGroups=input video
User=@SERVICE_USER@
EnvironmentFile=-/etc/renewvan/kiosk.env
ExecStart=/opt/renewvan/venvs/kiosk/bin/python /opt/renewvan/plugins/kiosk/kiosk.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
