[Unit]
Description=renewvan kiosk session (cage + Chromium)
Documentation=https://github.com/renewvan/hub/blob/main/plugins/kiosk/README.md
After=systemd-user-sessions.service systemd-logind.service plymouth-quit-wait.service docker.service
Wants=docker.service
# tty1 belongs to this unit; without this the login getty competes for it.
Conflicts=getty@tty1.service
After=getty@tty1.service
# The dashboard (nginx container) is awaited inside the launcher script, not
# here: compose containers aren't systemd units this one could order against.

[Service]
# Placeholder replaced by bin/bootstrap-kiosk-pi.sh with the kiosk user.
User=@KIOSK_USER@
# PAMName=login registers a real logind session on tty1, which is what hands
# cage a seat (DRM master + input devices) without seatd or a display manager,
# and creates /run/user/<uid> for the Wayland socket.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

# The Wayland socket name is whatever cage's wl_display_add_socket_auto finds
# free (wayland-0 on a clean boot, but not guaranteed). Nothing here depends
# on it: kiosk.py uses sysfs + evdev, and deploy.sh restarts this unit
# instead of launching a second Chromium into a guessed socket.
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -d -- /opt/renewvan/plugins/kiosk/renewvan-kiosk-browser.sh
# cage exits whenever its client exits, so "always" is what makes a Chromium
# crash recover and what lets deploy.sh reload the dashboard by restarting.
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
